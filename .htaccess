# ==============================================================================
# PortaCoCo Apache Configuration (.htaccess)
# Redirect all 404 errors and non-existent URLs to the main index page
# ==============================================================================

# Standard Apache Error Document Directive
ErrorDocument 404 /index.html

# Mod_Rewrite Catch-All Rule
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If requested path is not an existing file
  RewriteCond %{REQUEST_FILENAME} !-f
  # And not an existing directory
  RewriteCond %{REQUEST_FILENAME} !-d
  # Route cleanly to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# PortaCoCo Apache Configuration (.htaccess)
# Redirect all 404 errors and old/broken URLs directly to the homepage
# ==============================================================================

# Redirect standard 404 error requests to root
ErrorDocument 404 /

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow existing static files (CSS, JS, images, zip) to load without redirection
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect any non-existent page, old WordPress permalink, or broken URL to homepage
  RewriteRule ^.*$ / [R=302,L]
</IfModule>
